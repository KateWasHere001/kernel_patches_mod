+#ifdef CONFIG_KSU_SUSFS_SUS_MAP
+
+// 敏感关键词列表
+static const char *sensitive_keywords[] = {
+    "lsposed",
+    "xposed", 
+    "libstagefright",
+    "kernelsu",
+    "ksu",
+    "gadget",
+    "zygisk",
+    "com.wuxianlian",
+    "/data/adb/modules",
+    NULL
+};
+
+// 检查路径是否包含敏感关键词
+static bool susfs_path_contains_sensitive_keyword(struct file *file)
+{
+    char *path_buf, *file_path;
+    bool contains = false;
+    int i;
+    
+    if (!file)
+        return false;
+    
+    path_buf = kmalloc(PATH_MAX, GFP_ATOMIC);
+    if (!path_buf)
+        return false;
+    
+    file_path = d_path(&file->f_path, path_buf, PATH_MAX);
+    if (IS_ERR(file_path)) {
+        kfree(path_buf);
+        return false;
+    }
+    
+    // 转换为小写以进行不区分大小写的匹配
+    // 或者使用 strcasestr (如果可用)
+    for (i = 0; sensitive_keywords[i] != NULL; i++) {
+        if (strstr(file_path, sensitive_keywords[i])) {
+            contains = true;
+            break;
+        }
+    }
+    
+    kfree(path_buf);
+    return contains;
+}
+
